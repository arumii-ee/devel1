rules_version = '2';
// My Refrigerator - 가족 공유 보안 규칙
// ---------------------------------------------------------------
// - 모든 접근은 로그인(익명 로그인)이 필요합니다.
// - 가족 냉장고의 재료와 메모(댓글 포함)는 "멤버 명단"에 있는 기기만 읽고 쓸 수 있습니다.
// - 멤버가 되려면 현재 유효한 가족 코드(12자리)를 알아야 합니다.
// - 관리자(만든 사람)는 멤버를 내보내고 코드를 바꿀 수 있습니다.
// - 관리자가 30일 넘게 안 들어오면 다른 멤버가 관리자를 넘겨받을 수 있습니다.
// - 저장되는 데이터는 칸 이름·종류·길이를 엄격하게 검사합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function family(fid) {
      return get(familyPath(fid)).data;
    }
    function isMember(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }
    function isOwner(fid) {
      return signedIn() && exists(familyPath(fid))
        && family(fid).ownerUid == request.auth.uid;
    }
    // 헷갈리는 글자(I, L, O, 0, 1)를 뺀 12자리
    // 관리자가 30일 넘게 안 들어왔거나 멤버 명단에 없으면(앱 데이터 삭제 등) 다른 멤버가 넘겨받을 수 있음
    function ownerGone(fid, ownerUid) {
      let path = /databases/$(database)/documents/families/$(fid)/members/$(ownerUid);
      return !exists(path)
        || get(path).data.get('lastSeen', get(path).data.get('joinedAt', 0)) < request.time.toMillis() - 2592000000;
    }
    function validCode(c) {
      return c is string && c.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{12}$');
    }
    function validName(n) {
      return n is string && n.size() <= 10;
    }
    function optionalName(d, key) {
      return !(key in d) || validName(d[key]);
    }
    function validItem(d, itemId) {
      return d.keys().hasAll(['id', 'name', 'quantity', 'unit', 'location', 'expiry', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'name', 'quantity', 'unit', 'location', 'expiry', 'createdAt', 'updatedAt', 'addedBy', 'updatedBy'])
        && d.id == itemId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.quantity is number && d.quantity >= 0 && d.quantity <= 100000
        && d.unit is string && d.unit.size() <= 10
        && d.location in ['fridge', 'freezer', 'pantry']
        && (d.expiry == null || (d.expiry is string && d.expiry.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.createdAt is number && d.updatedAt is number
        && optionalName(d, 'addedBy') && optionalName(d, 'updatedBy');
    }
    function notFuture(t) {
      return t is number && t <= request.time.toMillis() + 600000;
    }
    function optionalTime(d, key) {
      return !(key in d) || notFuture(d[key]);
    }
    // 메모: 글 1~200자, 시각은 미래(10분 넘게)로 못 씀, 이름 10자 이하, 댓글 100개 이하
    function validMemo(d, memoId) {
      return d.keys().hasAll(['id', 'text', 'createdAt', 'by'])
        && d.keys().hasOnly(['id', 'text', 'createdAt', 'by', 'updatedAt', 'editedBy', 'comments', 'lastCommentId'])
        && d.id == memoId
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && notFuture(d.createdAt)
        && validName(d.by) && d.by.size() > 0
        && optionalTime(d, 'updatedAt') && optionalName(d, 'editedBy')
        && (!('comments' in d) || (d.comments is map && d.comments.size() <= 100))
        && (!('lastCommentId' in d) || (d.lastCommentId is string && d.lastCommentId.size() > 0 && d.lastCommentId.size() <= 40));
    }
    // 댓글: 글 1~200자, 시각은 미래로 못 씀, 이름 10자 이하
    function validComment(c, cid) {
      return c is map
        && c.keys().hasAll(['id', 'text', 'createdAt', 'by'])
        && c.keys().hasOnly(['id', 'text', 'createdAt', 'by', 'updatedAt', 'editedBy'])
        && c.id == cid
        && c.text is string && c.text.size() > 0 && c.text.size() <= 200
        && notFuture(c.createdAt)
        && validName(c.by) && c.by.size() > 0
        && optionalTime(c, 'updatedAt') && optionalName(c, 'editedBy');
    }
    // 메모 글 고치기: 글 · 고친 시각 · 고친 사람만 바꿀 수 있음 (남긴 사람 · 시각 · 댓글은 그대로)
    function editsMemoText(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['text', 'updatedAt', 'editedBy'])
        && after.diff(before).affectedKeys().hasAll(['updatedAt'])
        && 'editedBy' in after;
    }
    // 댓글 달기 · 고치기 · 지우기: 한 번에 lastCommentId 로 밝힌 댓글 1개만 바꿀 수 있음
    // 고칠 때는 댓글 남긴 사람 · 시각을 바꿀 수 없음
    function changesOneComment(before, after) {
      let cid = after.get('lastCommentId', '');
      let was = before.get('comments', {});
      let now = after.get('comments', {});
      return after.diff(before).affectedKeys().hasOnly(['comments', 'lastCommentId'])
        && cid != ''
        && now.diff(was).affectedKeys().hasOnly([cid])
        && (!(cid in now) || (validComment(now[cid], cid)
          && (!(cid in was) || (now[cid].createdAt == was[cid].createdAt && now[cid].by == was[cid].by))));
    }

    // 초대 코드 → 가족 찾기. 코드를 정확히 알아야만 읽을 수 있고, 목록 보기는 불가
    match /invites/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['familyId', 'createdAt'])
        && request.resource.data.familyId is string
        && request.resource.data.createdAt is number
        && isOwner(request.resource.data.familyId)
        && family(request.resource.data.familyId).code == code;
      allow delete: if signedIn() && isOwner(resource.data.familyId);
    }

    match /families/{fid} {
      allow get: if isMember(fid);
      allow list, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'code', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && validCode(request.resource.data.code)
        && request.resource.data.createdAt is number;
      // 관리자만: 코드 바꾸기, 또는 다른 멤버에게 관리자 넘기기
      // 관리자가 사라진 경우: 멤버가 자기 자신을 새 관리자로
      allow update: if (isOwner(fid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
          && validCode(request.resource.data.code))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
          && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.resource.data.ownerUid)))
      )) || (isMember(fid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && ownerGone(fid, resource.data.ownerUid));

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isMember(fid));
        allow list: if isMember(fid);
        // 본인만, 현재 유효한 가족 코드를 제시해야 가입
        allow create: if signedIn() && request.auth.uid == uid
          && exists(familyPath(fid))
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'code'])
          && validName(request.resource.data.name)
          && request.resource.data.joinedAt is number
          && request.resource.data.code == family(fid).code;
        // 본인 이름 · 마지막 접속 시각(lastSeen)만 수정
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastSeen'])
          && validName(request.resource.data.name)
          && (!('lastSeen' in request.resource.data)
            || (request.resource.data.lastSeen is number
              && request.resource.data.lastSeen <= request.time.toMillis() + 600000));
        // 본인 탈퇴, 또는 관리자가 내보내기
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(fid));
      }

      match /items/{itemId} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid) && validItem(request.resource.data, itemId);
      }

      // 메모와 댓글: 멤버 누구나 쓰고 · 고치고 · 지울 수 있음
      // (댓글은 메모 문서의 comments 칸에 { 댓글 id: 댓글 } 으로 저장)
      match /memos/{memoId} {
        allow read, delete: if isMember(fid);
        allow create: if isMember(fid) && validMemo(request.resource.data, memoId);
        allow update: if isMember(fid) && validMemo(request.resource.data, memoId)
          && (editsMemoText(resource.data, request.resource.data)
            || changesOneComment(resource.data, request.resource.data));
      }
    }
  }
}
